{
  "name": "com.dwjordan.herdr-agents",
  "version": "0.1.0",
  "description": "Stream Deck tile that lights up when a herdr-managed agent (Claude, Codex, Cursor...) is blocked or finished and waiting on you.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "link": "streamdeck link com.dwjordan.herdr-agents.sdPlugin",
    "unlink": "streamdeck unlink com.dwjordan.herdr-agents",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.dwjordan.herdr-agents\""
  },
  "author": "Dave Jordan",
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "20.x",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  }
}
